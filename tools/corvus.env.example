# Corvus development environment (copy to .env and adjust)
CORVUS_USE_TCP=1
CORVUS_TCP_HOST=127.0.0.1
CORVUS_TCP_PORT=4040
CORVUS_MGMT_HOST=127.0.0.1
CORVUS_MGMT_PORT=8080
CORVUS_API_KEY=dev-api-key
CORVUS_NODE_SOCK=/tmp/corvus-node.sock
CORVUS_COORDINATOR_PATH=/tmp/corvus-coordinator.json
CORVUS_DB_PATH=/tmp/corvus-dev/corvus.db
CORVUS_VM_STATE_DIR=/tmp/corvus-vms
CORVUS_LOG_LEVEL=INFO
# CORVUS_LOG_JSON=1

# Dummy OpenAI-compatible LLM for dummy-http provider (started by make dev-up)
# CORVUS_DUMMY_LLM_PORT=8765

# Operator console chat: http://127.0.0.1:8080/ui/chat  (admin-user / 0000)
# Seeded test-agent-01 uses in-process stub. dummy-http needs dummy-v1 on the manifest.

# Basic runtime turn (Engine 2 + Engine 3 only):
#   tools/run-turn.sh
#   CORVUS_CHAT_TEXT='Hello from operator' tools/run-turn.sh --once
# Full stack with tools + memory (opt-in):
#   CORVUS_LLM_LOCAL_TOOLS=echo,terminal tools/run-turn.sh --once --all-engines
# CORVUS_LLM_STREAM=1

# Correlation chain depth for multi-hop tool turns (default 16)
# CORVUS_MAX_CHAIN_DEPTH=16

# Max wall-clock for a single agent turn (seconds, default 120). Bounds the
# Agent Loop's wait for a terminal phase and Engine 1's COLLECT loop; on expiry
# the turn is moved to the terminal ABORTED phase so the runtime always exits.
# CORVUS_TURN_TIMEOUT_SECONDS=120

# Server correlation / control-plane turn budget (seconds, default 300).
# Distinct from CORVUS_TURN_TIMEOUT_SECONDS above — do not assume they are aliases.
# CORVUS_TURN_TIMEOUT=300
